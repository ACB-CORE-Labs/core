{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run core test:*)",
      "Bash(uv run core eval:*)",
      "Bash(uv run core doctor:*)",
      "Bash(uv sync --locked)",
      "Bash(uv run python -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list)",
      "Bash(git stash list)",
      "Bash(git fetch forgejo-https:*)",
      "Bash(git fetch forgejo:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(ollama list)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)"
    ],
    "deny": [
      "Bash(gh:*)",
      "Bash(tea:*)",
      "Bash(pip install:*)",
      "Bash(docker run:*)",
      "Bash(docker exec:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_paths.py\"",
            "timeout": 10,
            "statusMessage": "Checking invariant paths"
          }
        ]
      }
    ]
  },
  "env": {
    "OLLAMA_OFFLOAD_MODEL": "gemma4:e2b"
  }
}
